# ==============================================================================
# DocuAgent AI Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_SECRET_KEY=change-this-to-a-secure-random-secret-key

# Server & Network
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8030
FRONTEND_PORT=5173
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Multi-Agent Orchestrator (hybrid, crewai, langgraph)
AGENT_ORCHESTRATOR=hybrid
CREWAI_PROCESS_MODE=sequential
MAX_REVISION_LOOPS=3
QUALITY_THRESHOLD_SCORE=85

# LLM Providers (Ollama Cloud / Local / OpenAI Compatible)
LLM_PROVIDER=ollama_cloud # options: ollama_cloud, ollama_local, openai, litellm
OLLAMA_BASE_URL=https://ollama.com/api # Or your cloud endpoint
OLLAMA_API_KEY=your-ollama-cloud-api-key
DEFAULT_MODEL=llama3.3:70b # or qwen2.5:72b
FAST_MODEL=llama3.1:8b

# Optional OpenAI / Anthropic Keys for fallback
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Playwright & Browser Config
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_VIEWPORT_WIDTH=1440
PLAYWRIGHT_VIEWPORT_HEIGHT=900
PLAYWRIGHT_HIGHLIGHT_COLOR=#ef4444
SCREENCAST_FPS=15
SCREENCAST_QUALITY=80

# Storage Locations
STORAGE_DIR=./data/storage
SCREENSHOTS_DIR=./data/storage/screenshots
EXPORTS_DIR=./data/storage/exports
DATABASE_URL=sqlite+aiosqlite:///./data/docuagent.db
